[1.36, "o", "\u001b[1;1H\u001b[49m                                                                                                            \u001b[0m\r\n\u001b[2;1H\u001b[49m  \u001b[0m\u001b[1;34;49m/settings\u001b[0m\u001b[49m                                                                                               \u001b[0m\u001b[33;49m\u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[3;1H\u001b[49m  \u001b[0m\u001b[90;49mEvery setting humanize keeps. What you change is held until you save it.\u001b[0m\u001b[49m                                \u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[4;1H\u001b[49m  \u001b[0m\u001b[49m                                                                                                        \u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[5;1H\u001b[49m  \u001b[0m\u001b[90;49m╭\u001b[0m\u001b[90;49m──────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[90;49m╮\u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[6;1H\u001b[49m  \u001b[0m\u001b[90;49m│\u001b[0m\u001b[97;100m ⚙  \u001b[0m\u001b[1;97;100mGeneral\u001b[0m\u001b[97;100m                                                                 details off · reports off\u001b[0m\u001b[49m \u001b[0m\u001b[90;49m│\u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[7;1H\u001b[49m  \u001b[0m\u001b[90;49m│\u001b[0m\u001b[97;100m    this machine: what runs show, the /btw agent, error reports\u001b[0m\u001b[97;100m                                      \u001b[0m\u001b[49m \u001b[0m\u001b[90;49m│\u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[8;1H\u001b[49m  \u001b[0m\u001b[90;49m│\u001b[0m\u001b[90;49m─────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[49m \u001b[0m\u001b[90;49m│\u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[9;1H\u001b[49m  \u001b[0m\u001b[90;49m│\u001b[0m\u001b[39;49m \u001b[0m\u001b[34;49m◉\u001b[0m\u001b[39;49m  \u001b[0m\u001b[1;39;49mAccounts\u001b[0m\u001b[39;49m                                                                                \u001b[0m\u001b[90;49m1 account\u001b[0m\u001b[49m \u001b[0m\u001b[90;49m│\u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[10;1H\u001b[49m  \u001b[0m\u001b[90;49m│\u001b[0m\u001b[39;49m    \u001b[0m\u001b[90;49mwhat agents sign in as, under each CLI\u001b[0m\u001b[39;49m                                                           \u001b[0m\u001b[49m \u001b[0m\u001b[90;49m│\u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[11;1H\u001b[49m  \u001b[0m\u001b[90;49m│\u001b[0m\u001b[90;49m─────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[49m \u001b[0m\u001b[90;49m│\u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[12;1H\u001b[49m  \u001b[0m\u001b[90;49m│\u001b[0m\u001b[39;49m \u001b[0m\u001b[34;49m↻\u001b[0m\u001b[39;49m  \u001b[0m\u001b[1;39;49mFallback\u001b[0m\u001b[39;49m                                                                                  \u001b[0m\u001b[90;49m0 rules\u001b[0m\u001b[49m \u001b[0m\u001b[90;49m│\u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[13;1H\u001b[49m  \u001b[0m\u001b[90;49m│\u001b[0m\u001b[39;49m    \u001b[0m\u001b[90;49mwhere a turn goes when its agent fails\u001b[0m\u001b[39;49m                                                           \u001b[0m\u001b[49m \u001b[0m\u001b[90;49m│\u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[14;1H\u001b[49m  \u001b[0m\u001b[90;49m│\u001b[0m\u001b[90;49m─────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[49m \u001b[0m\u001b[90;49m│\u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[15;1H\u001b[49m  \u001b[0m\u001b[90;49m│\u001b[0m\u001b[39;49m \u001b[0m\u001b[34;49m▦\u001b[0m\u001b[39;49m  \u001b[0m\u001b[1;39;49mRuntimes\u001b[0m\u001b[39;49m                                                                               \u001b[0m\u001b[90;49m3 machines\u001b[0m\u001b[49m \u001b[0m\u001b[90;49m│\u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[16;1H\u001b[49m  \u001b[0m\u001b[90;49m│