where the CLI is there, else local\u001b[0m\u001b[39;49m                               \u001b[0m\r\n\u001b[11;1H\u001b[39;49m     \u001b[0m\u001b[90;49m 4.\u001b[0m\u001b[39;49m image                        \u001b[0m\u001b[90;49mdefault image, unless specified by the flow\u001b[0m\u001b[39;49m                           \u001b[0m\r\n\u001b[12;1H\u001b[39;49m     \u001b[0m\u001b[90;49m 5.\u001b[0m\u001b[39;49m OCI runtime                  \u001b[0m\u001b[90;49me.g. nvidia; blank for daemon default\u001b[0m\u001b[39;49m                                 \u001b[0m\r\n\u001b[13;1H\u001b[39;49m     \u001b[0m\u001b[90;49m 6.\u001b[0m\u001b[39;49m run args                     \u001b[0m\u001b[90;49mextra arguments for docker run\u001b[0m\u001b[39;49m                                        \u001b[0m\r\n\u001b[14;1H\u001b[39;49m     \u001b[0m\u001b[90;49m 7.\u001b[0m\u001b[39;49m max containers               \u001b[0m\u001b[90;49mmax concurrent containers; blank for no limit\u001b[0m\u001b[39;49m                         \u001b[0m\r\n\u001b[15;1H\u001b[39;49m     \u001b[0m\u001b[90;49m 8.\u001b[0m\u001b[39;49m workdir                      \u001b[0m\u001b[90;49mdefault working directory when -e specifies no directory\u001b[0m\u001b[39;49m              \u001b[0m\r\n\u001b[16;1H\u001b[39;49m     \u001b[0m\u001b[90;49m 9.\u001b[0m\u001b[39;49m falls back to                \u001b[0m\u001b[90;49mruntimes to try in order if this one cannot: docker:box, ssh:gpu2\u001b[0m\u001b[39;49m     \u001b[0m\r\n\u001b[17;1H\u001b[39;49m     \u001b[0m\u001b[90;49m10.\u001b[0m\u001b[39;49m cpus                         \u001b[0m\u001b[90;49mmax CPUs; blank to use all host CPUs\u001b[0m\u001b[39;49m                                  \u001b[0m\r\n\u001b[18;1H\u001b[39;49m     \u001b[0m\u001b[90;49m11.\u001b[0m\u001b[39;49m memory                       \u001b[0m\u001b[90;49me.g. 64G; blank to use all host memory\u001b[0m\u001b[39;49m                                \u001b[0m\r\n\u001b[19;1H\u001b[39;49m   